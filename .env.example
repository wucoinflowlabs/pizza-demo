# Server-only. Never prefix these with NEXT_PUBLIC_.
PAYMENTS_API_BASE_URL=https://api-sandbox.coinflow.cash/api
# Admin-scoped API key for Adora's parent merchant account (merchantId "adora").
PAYMENTS_API_KEY=

# Signs invite links and session cookies. Any long random string.
APP_SECRET=

# Supabase — Adora Demo. Publishable key is safe in the browser. Secret key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=https://vvtilbdpicdhdomvnxov.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Webhook Validation Key from the Coinflow merchant dashboard. Webhooks go to /api/webhooks/coinflow.
PAYMENTS_WEBHOOK_VALIDATION_KEY=

# Shows the live Coinflow activity panel (API calls + webhooks) on every page.
DEVTOOLS_ENABLED=
# Shared event store for the panel on Vercel (set by the Upstash Marketplace integration).
# Leave blank locally to keep events in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo-only: real production credentials used to fire a REAL Venmo/PayPal payout
# when the Methods-tab Send button is clicked on a withdrawer whose user id
# matches DEMO_REAL_PAYOUT_USER_ID. Server-only. Leave blank to disable the
# feature entirely (the button is hidden).
PAYMENTS_PROD_API_BASE_URL=https://api.coinflow.cash/api
PAYMENTS_PROD_API_KEY=
DEMO_REAL_PAYOUT_USER_ID=teststaff

# Coinflow user id in-person tips are cashed out to. Online checkout tips are excluded.
# Must match a staff.cf_user_id row.
TIP_RECIPIENT_CF_USER_ID=teststaff
